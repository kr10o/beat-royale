{
	"name": "beat-battle-royale",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-07",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"kv_namespaces": [
		{
			"binding": "LOBBY_CACHE",
			"id": "d623ec4ca94b46e78ba99a856f0870fc"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "beat-royale",
			"database_id": "67ad1b7e-3e68-43f3-9ab8-84be8f2ca02f"
		}
	],
	"r2_buckets": [
		{
			"binding": "ASSETS_BUCKET",
			"bucket_name": "beat-royale-assets"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "BATTLE_LOBBY",
				"class_name": "BattleLobbyDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_classes": [
				"BattleLobbyDO"
			]
		}
	]
}